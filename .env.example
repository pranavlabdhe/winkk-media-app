# Production database (Turso / libSQL)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Optional: password used when the first owner account is seeded.
# Change this before exposing the app publicly.
SEED_OWNER_PASSWORD=
# Optional: password for the seeded demo employee accounts.
SEED_DEMO_PASSWORD=
